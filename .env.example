# Country code + area code + number, digits only. Example format: 55DDNUMBER
VITE_WHATSAPP_NUMBER=

# Optional: canonical origin. Defaults to the public URL in site.config.json.
# Use the production domain, even when building a preview.
SITE_URL=https://landing-page-goms.vercel.app/
# Vercel sets VERCEL_ENV automatically. For staging elsewhere, set VERCEL_ENV=preview.
